	@Query("select e from Employee e where e.emailId=:email and e.mobileNo=:mobile")
	Employee findByEmailIdAndMobileNo(@Param("email") String email, @Param("mobile") String mobile);
	
	@Query("select e from Employee e where e.emailId=:x or e.mobile=:m")
	List<Employee> searchByEmailIdOrMobile(@Param("x") String email,@Param("m") String mobile);
}

